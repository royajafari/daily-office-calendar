{
  "name": "daily-office-sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polls calendar_sync_queue via ORDS and upserts/deletes events on the office head's Google Calendar. Runs in dry-run mode without Google credentials.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

# ORDS base URL for the daily.office module (see db/packages/003_ords_modules.sql)
ORDS_BASE_URL=http://localhost:8080/ords/daily_office/daily-office
ORDS_USER=
ORDS_PASSWORD=

POLL_INTERVAL_MS=5000

# Force dry-run even if Google credentials below are set (useful for local testing)
SYNC_DRY_RUN=false

# Google Calendar service-account credentials (Gate G4 — docs/architecture.md).
# Leave empty to run in dry-run mode. Never commit real values.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

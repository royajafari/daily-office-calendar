# اگر خالی بماند، دمو با داده‌ی نمایشی (mock) کار می‌کند.
# در صورت پر شدن، به endpointهای عمومی محدود ORDS وصل می‌شود
# (فقط GET availability و POST requests — هرگز CRUD رئیس یا credential دیتابیس).
ORACLE_API_BASE_URL=

# کلید امضای توکن‌های «من ربات نیستم» در فرم ثبت درخواست (حداقل ۳۲ کاراکتر تصادفی).
# در production الزامی است؛ بدون آن فرم ثبت درخواست کار نمی‌کند. در توسعه‌ی محلی اگر
# خالی بماند، یک کلید موقت ساخته می‌شود. ساختن یک مقدار:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET=

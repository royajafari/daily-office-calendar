# کپی کنید به docker/.env و مقادیر واقعی را پر کنید. این فایل هرگز کامیت نمی‌شود
# (در .gitignore ریشه‌ی مخزن قرار دارد). رمزها را خودتان انتخاب می‌کنید —
# هیچ سرویس بیرونی رمز نمی‌سازد یا آن را در اختیار من قرار نمی‌دهد.

# --- Oracle Database (gvenzl/oracle-free) ---
# قوانین Oracle: حداقل ۸ کاراکتر، حداقل یک حرف بزرگ، یک حرف کوچک، یک رقم؛
# نویسه‌های غیرمجاز در رمز SYS/SYSTEM را وارد نکنید (مثل نقل‌قول تکی/دوتایی).
ORACLE_PASSWORD=

# کاربر schema اپلیکیشن که Liquibase و ORDS با آن کار می‌کنند
APP_USER=daily_office
APP_USER_PASSWORD=

# --- APEX 26.1 install (docker/db/setup/10-apex-26.1.sh) ---
# قوانین رمز ادمین APEX 26.1 (تجربه‌شده، سخت‌گیرانه‌تر از رمز Oracle معمولی):
# حداقل ۸ کاراکتر، حداقل یک حرف بزرگ، یک حرف کوچک، یک رقم، و حداقل یک نویسه‌ی
# خاص **از مجموعه‌ی دقیق APEX** (!"`'#$%&()[]{},.*+-/|\:;?_~ — مثلاً !, #, (, )
# امن‌اند؛ ^ و @ در این مجموعه نیستند و رد می‌شوند)؛ نباید شامل نام کاربری
# (ADMIN) باشد. بدون نویسه‌ی خاص معتبر، apxchpwd.sql با ORA-20001
# ("Invalid password") رد می‌شود.
APEX_ADMIN_PASSWORD=

# رمز کاربرهای APEX_LISTENER و APEX_REST_PUBLIC_USER (apex_rest_config.sql)
APEX_REST_PASSWORD=

# --- ORDS ---
# رمز واقعی کاربر SYS — باید دقیقاً همان مقدار ORACLE_PASSWORD باشد. ORDS با
# این رمز به SYS وصل می‌شود؛ SYS فقط همان یک رمز واقعی را دارد (همانی که با
# ORACLE_PASSWORD موقع ساخت دیتابیس تنظیم شد)، پس این دو نمی‌توانند متفاوت
# باشند — اگر متفاوت باشند ORDS با خطای مبهم "Database not ready" گیر می‌کند.
ORDS_SYS_PASSWORD=

# رمز کاربر ORDS_PUBLIC_USER: کانتینر ORDS در اولین اجرا این کاربر را با همین
# رمز می‌سازد و از آن به بعد با آن به دیتابیس وصل می‌شود.
ORDS_PUBLIC_USER_PASSWORD=

# کپی کنید به docker/.env و مقادیر واقعی را پر کنید. این فایل هرگز کامیت نمی‌شود
# (در .gitignore ریشه‌ی مخزن قرار دارد). رمزها را خودتان انتخاب می‌کنید —
# هیچ سرویس بیرونی رمز نمی‌سازد یا آن را در اختیار من قرار نمی‌دهد.

# --- Oracle Database (gvenzl/oracle-free) ---
# قوانین Oracle: حداقل ۸ کاراکتر، حداقل یک حرف بزرگ، یک حرف کوچک، یک رقم؛
# نویسه‌های غیرمجاز در رمز SYS/SYSTEM را وارد نکنید (مثل نقل‌قول تکی/دوتایی).
ORACLE_PASSWORD=

# کاربر schema اپلیکیشن که Liquibase و ORDS با آن کار می‌کنند
APP_USER=daily_office
APP_USER_PASSWORD=

# --- APEX 26.1 install (docker/db/setup/10-apex-26.1.sh) ---
# قوانین رمز ادمین APEX: حداقل ۸ کاراکتر، حداقل یک حرف بزرگ، یک حرف کوچک،
# یک رقم؛ نباید شامل نام کاربری (ADMIN) باشد.
APEX_ADMIN_PASSWORD=

# رمز کاربر ORDS_PUBLIC_USER / REST که ORDS برای اتصال به دیتابیس استفاده می‌کند
APEX_REST_PASSWORD=

# --- ORDS ---
# رمزی که برای اتصال ORDS quick-start container به SYS استفاده می‌شود؛
# می‌تواند با ORACLE_PASSWORD یکسان باشد یا جدا باشد.
ORDS_SYS_PASSWORD=

# Secrets — never commit
.env
.env.*
!.env.example
docker/.env

# Oracle APEX official distribution (license-restricted, user must download)
docker/apex-dist/*
!docker/apex-dist/.gitkeep
docker/drivers/*.jar

# APEX static assets extracted from the ZIP above, served to ORDS — same
# license restriction, regenerate from docker/apex-dist/*.zip, don't commit
docker/apex-images/*
!docker/apex-images/.gitkeep

# Node / Next.js
node_modules/
.next/
.npm-cache/
out/
coverage/
dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
